{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lark",
  "version": "2.2.2",
  "identifier": "dev.lark.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:47321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lark",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https://cdn.discordapp.com https://media.discordapp.net",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:47321 ws://127.0.0.1:47321",
        "script-src": "'self' 'unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "resources": ["../themes", "../plugins", "../config.example.toml"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A small personal Discord client",
    "longDescription": "Lark is a fast personal Discord client for one account on macOS and Windows.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
