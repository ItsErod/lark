{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lark",
  "version": "3.0.1",
  "identifier": "dev.lark.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:47321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lark",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://cdn.discordapp.com https://media.discordapp.net https://*.discordapp.com https://*.discordapp.net https://media.tenor.com https://c.tenor.com https://media.giphy.com https://i.giphy.com https://*.giphy.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' blob: data: asset: http://asset.localhost https://cdn.discordapp.com https://media.discordapp.net https://*.discordapp.com https://*.discordapp.net https://media.tenor.com https://c.tenor.com https://media.giphy.com https://i.giphy.com https://*.giphy.com",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:47321 ws://127.0.0.1:47321",
        "script-src": "'self' 'unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "resources": ["../config.example.toml"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A small personal Discord client",
    "longDescription": "Lark is a fast personal Discord client for one account on macOS and Windows.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lark"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQkJGMjlENTk0RjZCQUUKUldTdWEwOVpuZks3TFRKUW4wQSt1SXJ1ZXlBTVZpaGlISHNJU0dydVVhVW1JSWd0dklidEgwazUK",
      "endpoints": [
        "https://github.com/ItsErod/lark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
