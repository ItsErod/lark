{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lark main window. The webview can listen for events, read window state, copy voice diagnostics, check for updates, relaunch after an update is installed, and load a signed interface bundle. It cannot start a shell or create windows.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-focused",
    "core:window:allow-is-minimized",
    "core:window:allow-is-maximized",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "allow-interface-update",
    "allow-get-config",
    "allow-save-config",
    "allow-app-paths",
    "allow-has-token",
    "allow-set-token",
    "allow-clear-token",
    "allow-seal-drafts",
    "allow-open-drafts",
    "allow-open-discord-login",
    "allow-open-browser-login",
    "allow-cancel-browser-login",
    "allow-start-qr-login",
    "allow-stop-qr-login",
    "allow-connect",
    "allow-disconnect",
    "allow-fetch-guild-channels",
    "allow-fetch-roles",
    "allow-fetch-members",
    "allow-request-members",
    "allow-fetch-profile",
    "allow-fetch-dms",
    "allow-fetch-friends",
    "allow-open-dm",
    "allow-fetch-messages",
    "allow-send-message",
    "allow-edit-message",
    "allow-delete-message",
    "allow-toggle-reaction",
    "allow-typing",
    "allow-read-theme",
    "allow-write-theme",
    "allow-list-themes",
    "allow-set-window-material",
    "allow-list-plugins",
    "allow-read-plugin",
    "allow-store-index",
    "allow-install-store-item",
    "allow-preview-store-theme",
    "allow-uninstall-store-item",
    "allow-installed-store",
    "allow-open-store-page",
    "allow-read-public-profile",
    "allow-open-public-profile",
    "deep-link:default",
    "allow-join-voice",
    "allow-leave-voice",
    "allow-ring-call",
    "allow-stop-ringing",
    "allow-set-voice-self",
    "allow-set-presence",
    "allow-hardware-snapshot",
    "allow-ack-message",
    "allow-fetch-pins",
    "allow-pin-message",
    "allow-unpin-message",
    "allow-fetch-emojis",
    "allow-fetch-threads",
    "allow-search-messages",
    "allow-set-unread",
    "allow-preview-invite",
    "allow-accept-invite",
    "allow-set-channel-collapsed",
    "allow-set-guild-folders",
    "allow-set-minimize-to-tray",
    "allow-set-autostart",
    "allow-start-screen-share",
    "allow-stop-screen-share",
    "allow-sync-voice-overlay",
    "allow-save-clip",
    "allow-clip-status",
    "allow-set-clip-pace",
    "allow-read-clip",
    "allow-show-clip",
    "allow-open-clips-dir",
    "allow-list-clips",
    "allow-rename-clip",
    "allow-delete-clip",
    "allow-trim-clip",
    "allow-compress-clip",
    "allow-voice-diagnostics",
    "allow-list-audio-devices"
  ]
