{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lark main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    "allow-get-config",
    "allow-save-config",
    "allow-app-paths",
    "allow-has-token",
    "allow-set-token",
    "allow-clear-token",
    "allow-open-discord-login",
    "allow-open-browser-login",
    "allow-cancel-browser-login",
    "allow-start-qr-login",
    "allow-stop-qr-login",
    "allow-connect",
    "allow-disconnect",
